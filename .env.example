# Copy to .env (same folder) or set as environment variables in the MCP config.
GAPIFY_BASE_URL=https://app.gapify.ai
# User API key: Profile Settings -> Access Token. Used by all Application endpoints.
GAPIFY_API_ACCESS_TOKEN=
# Optional: default account id so you don't pass account_id on every call.
GAPIFY_ACCOUNT_ID=
# Optional: Super Admin -> Platform Apps. Only needed for gapify_platform_* tools.
GAPIFY_PLATFORM_APP_API_KEY=
# Optional: used as fallback for message/conversation endpoints if no user token is set.
GAPIFY_AGENT_BOT_API_KEY=
